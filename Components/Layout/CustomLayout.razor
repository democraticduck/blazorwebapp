@inherits LayoutComponentBase

<MudThemeProvider Theme="CustomTheme" />
<MudPopoverProvider />


<MudDialogProvider />


<MudSnackbarProvider />
@*Bcuz one section outlet gets removed and another gets put, and child calls it, so null reference*@
<MudLayout >
    <MudAppBar Elevation="1">
        
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Edge="Edge.Start" OnClick="DrawerToggle" />
            <MudSpacer />
            
        
            <MudText Color="Color.Dark"><SectionOutlet SectionName="Title" /></MudText>
        
        <MudSpacer />
        <MudStack Row="true">
            <MudIconButton Icon="@Icons.Material.Filled.Notifications" Title="Favorite" />
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Title="Favorite" />
            <MudMenu AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.BottomCenter">
                <ActivatorContent>
                    <MudIconButton Icon="@Icons.Material.Filled.Person" />
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Label="Profile" />
                    <MudMenuItem Label="Theme" />
                    <MudMenuItem Label="Usage" />
                </ChildContent>
            </MudMenu>
        </MudStack>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2">
        <MudStack Class="m-3">
            <MudImage ObjectFit="ObjectFit.Contain" Fluid="true" Height="200" Width="400" Src="pbb_img.png" Alt="pbb_img" Elevation="25" Class="shadow-none" />
        </MudStack>
        <MudDivider DividerType="DividerType.Inset" Class="mx-2 my-3" />
        <MudStack> @*Add Match to each navlink*@
            <MudNavMenu Rounded="true" Margin="Margin.Dense" Color="Color.Secondary" Class="pa-2">
                <MudNavLink Match="NavLinkMatch.All" Href="/" Class="sidebar-nav-item" Icon="@Icons.Material.Filled.Dashboard">Home</MudNavLink>
                <MudNavLink Match="NavLinkMatch.Prefix" Class="sidebar-nav-item" Href="/tables" Icon="@Icons.Material.Filled.Storage">Tables</MudNavLink>
                <MudNavLink Match="NavLinkMatch.Prefix" Class="sidebar-nav-item" Href="/form" Icon="@Icons.Material.Filled.Storage">Form</MudNavLink>
                <MudNavLink Match="NavLinkMatch.Prefix" Class="sidebar-nav-item" Href="/auth/logout.html" Icon="@Icons.Material.Filled.Storage">Logout</MudNavLink>
            </MudNavMenu>
        </MudStack>
        
        
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
<style>
    .mud-nav-link:hover, .mud-icon-button:hover {
        color: var(--mud-palette-secondary);
    }

   
</style>

