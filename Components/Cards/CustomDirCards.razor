
<MudGrid>
    @foreach (var item in Elements)
    {
        <MudItem>
            <MudButton OnClick="() => OpenDialogAsync(item)">
            <MudCard Style="text-align:left;">
                <MudCardHeader>
                    <CardHeaderContent >
                        <MudText Typo="Typo.h6">@item.Category</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>@string.Join(", ", item.navListItems)</MudText>
                    
                </MudCardContent>
            </MudCard>
            </MudButton>
        </MudItem> 
    }
</MudGrid>

