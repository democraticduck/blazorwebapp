@page "/login"
@layout blazorwebapp.Components.Layout.EmptyLayout
@using MudBlazor
@inject NavigationManager Nav

<div class="bg"></div>

<header class="brand">
    <img src="images/logo.png" alt="eLDS Logo" class="brand__icon" />
    <span class="brand__word">eLDS</span>
</header>

<div class="wrap">
    <!-- rename Class from 'card' -> 'auth-card' to avoid Bootstrap/Mud conflicts -->
    <MudPaper Class="auth-card" Elevation="0" Outlined="false" Square="false">
        <MudText Typo="Typo.h4" Align="Align.Center" Class="title">Login</MudText>

        <MudForm>
            <MudTextField T="string" Label="Email"
                          @bind-Value="Email"
                          Variant="Variant.Filled" Class="input" />

            <MudTextField T="string" Label="Password"
                          @bind-Value="Password"
                          Variant="Variant.Filled"
                          InputType="InputType.Password"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.VisibilityOff"
                          Class="input mt" />

            <MudLink Href="#" Class="link">Forgot Password?</MudLink>

            <MudButton Variant="Variant.Filled" Color="Color.Error" Class="btn"
                       OnClick="@(()=> Nav.NavigateTo("/"))">
                Sign in
            </MudButton>
        </MudForm>
    </MudPaper>
</div>

@code {
    private string? Email { get; set; }
    private string? Password { get; set; }
}
