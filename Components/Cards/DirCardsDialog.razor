@using MudBlazor
@using blazorwebapp.Components.Shared.Navigation
@using blazorwebapp.Components.Dialog
<CustomDialog>
    <Title>
        Select Table
    </Title>
        <Body>
        <MudContainer MaxWidth="MaxWidth.False" Class="pa-4">
            <MudTable T="NavListItem"
                      Items="@Elements"
                      @ref="mudTable"
                      Hover="true"
                      Striped="true"
                      Dense="true"
                      RowClass="cursor-pointer transition-all duration-200"
                      RowClassFunc="@SelectedRowClassFunc"
                      OnRowClick="RowClickEvent"
                      Breakpoint="Breakpoint.None"
                      Elevation="0"
                      Class="rounded-lg"
                      Style="border: 1px solid var(--mud-palette-divider);">

                <ToolBarContent >
                    <div class="w-100 pa-2">

                        <CustomNavSearchBox Elements="@Elements"
                                            Variant="Variant.Outlined"
                                            
                                            Style="width: 320px;"
                                             />
                    </div>
                </ToolBarContent>

                <HeaderContent>
                    <MudTh Class="font-weight-bold"
                           Style="background-color: var(--mud-palette-background-grey); color: var(--mud-palette-text-primary);">
                        <div class="d-flex align-center gap-2">
                            <span>Tables</span>
                        </div>
                    </MudTh>
                </HeaderContent>

                <RowTemplate>
                    <MudTd DataLabel="Name"
                           Style="color: inherit; padding: 12px 16px;">
                        <div class="d-flex align-center gap-3">
                            
                            <MudText Typo="Typo.body1"
                                     Class="font-weight-medium">
                                @context.Name
                            </MudText>
                        </div>
                    </MudTd>
                </RowTemplate>

                <NoRecordsContent>
                    <div class="d-flex flex-column align-center justify-center pa-8">
                        <MudIcon Icon="@Icons.Material.Filled.SearchOff"
                                 Color="Color.Default"
                                 Size="Size.Large"
                                 Class="mb-4" />
                        <MudText Typo="Typo.h6"
                                 Color="Color.Default"
                                 Class="mb-2">
                            No tables found
                        </MudText>
                        <MudText Typo="Typo.body2"
                                 Color="Color.Default">
                            Try adjusting your search criteria
                        </MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudContainer>
    </Body>
  </CustomDialog>

<style>
    .transition-all {
        transition: all 0.2s ease-in-out;
    }

    .duration-200 {
        transition-duration: 200ms;
    }

</style>