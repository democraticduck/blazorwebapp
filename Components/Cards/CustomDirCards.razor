<MudGrid Spacing="3">
    @foreach (var item in Elements)
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <MudButton OnClick="() => OpenDialogAsync(item)">
                <MudCard Class="hover-card cursor-pointer">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6" Color="Color.Primary">@item.Category</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudDivider />
                    <MudCardContent>
                        <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                            @foreach (var navItem in item.navListItems)
                            {
                                <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">@navItem.Name</MudChip>
                            }
                        </MudStack>
                    </MudCardContent>
                </MudCard>
            </MudButton>
        </MudItem>
    }
</MudGrid>

<style>
    .hover-card {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 6px 12px rgba(0,0,0,0.15);
    }
    .cursor-pointer {
        cursor: pointer;
    }
</style>
